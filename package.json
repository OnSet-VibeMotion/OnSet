{
  "name": "onset",
  "private": true,
  "description": "片场：TypeScript 引擎、onset 命令行与 Electron 桌面客户端",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "desktop": "npm run start -w onset-desktop",
    "build": "npm run build -w onset-desktop",
    "typecheck": "npm run typecheck -w onset-desktop",
    "lint": "node scripts/lint.mjs lint",
    "lint:fix": "node scripts/lint.mjs lint:fix",
    "format": "node scripts/lint.mjs format",
    "format:check": "node scripts/lint.mjs format:check",
    "test:lint": "node --test scripts/lint.test.mjs"
  },
  "overrides": {
    "app-builder-lib": {
      "minimatch@10": "11.0.9"
    },
    "@electron/universal": {
      "minimatch@9": "11.0.9"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8"
  }
}
